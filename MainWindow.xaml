<Window x:Class="SteamRandomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamRandomizer" Height="600" Width="800"
        Foreground="#FFDCD9D9" Cursor="Hand" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF2A2A3E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Text="🎮 SteamRandomizer" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Spielanzeige -->
        <StackPanel Grid.Row="1" Margin="0,20" HorizontalAlignment="Center">
            <Image Name="GameImage" Width="200" Height="200" Margin="0,10"/>
            <TextBlock Name="GameTitle" FontSize="20" FontWeight="SemiBold" Text="Spielname" HorizontalAlignment="Center"/>
            <TextBlock Name="GameGenre" FontSize="14" Text="Genre: ..." HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Name="RandomButton" Content="🎲 Zufallsspiel" Click="RandomButton_Click" Width="150" Margin="10"/>
            <Button Name="FavoriteButton" Content="⭐ Favorit" Click="FavoriteButton_Click" Width="100" Margin="10"/>
            <Button Name="FilterButton" Content="🔍 Filter" Click="FilterButton_Click" Width="100" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
